# data and generated outputs — never commit these
data/
*.zip

# outputs/ is excluded EXCEPT the trained heads: they are ~1 MB each and having
# them in git is what stopped us WhatsApp-ing checkpoints around. A parent-dir
# exclude cannot be undone by a negation, so it is opened one level at a time.
outputs/*
!outputs/models/
outputs/models/*
!outputs/models/*.pt

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# virtualenvs — ALL of them. Only `.venv/` was listed before, which left
# `venv/` (the one that actually has torch + streamlit in it) and `.venv-1/`
# staged by `git add .`.
venv/
.venv/
.venv-1/
.venv*/

# models / caches

*.npy

# one-off dataset-audit scratch output (regenerate with the find/comm commands)
expected.txt
present.txt
missing_eval_files.txt

# local test audio (not shared)
testcall.wav

# local backups made before edits
*.bak
